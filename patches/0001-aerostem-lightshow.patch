diff --git a/libraries/AP_GPS/AP_GPS.cpp b/libraries/AP_GPS/AP_GPS.cpp
index 558b1b2d..a8ce01cd 100644
--- a/libraries/AP_GPS/AP_GPS.cpp
+++ b/libraries/AP_GPS/AP_GPS.cpp
@@ -673,6 +673,29 @@ AP_GPS_Backend *AP_GPS::_detect_instance(uint8_t instance)
         dstate->auto_detected_baud = false; // specified, not detected
         return NEW_NOTHROW AP_GPS_GSOF(*this, params[instance], state[instance], _port[instance]);
 #endif //AP_GPS_GSOF_ENABLED
+#if AP_GPS_NOVA_ENABLED
+    case GPS_TYPE_NOVA:
+        // NovAtel-protocol receivers (NovAtel, Bynav, ComNav) are not
+        // auto-detected: the driver is created blindly and configures the
+        // receiver itself. Cycling through baud rates here (as done for
+        // auto-detected types) meant that a receiver which booted later
+        // than the autopilot, or dropped out for more than a few seconds,
+        // was retried at the wrong baud rate and could take a long time
+        // to come back - or never came back. Always use the configured
+        // SERIALn_BAUD instead.
+        if (_port[instance] == nullptr) {
+            return nullptr;
+        }
+        dstate->auto_detected_baud = false; // specified, not detected
+        {
+            const uint32_t baud = AP::serialmanager().find_baudrate(AP_SerialManager::SerialProtocol_GPS, instance);
+            if (baud != 0 && _port[instance]->get_baud_rate() != baud) {
+                _port[instance]->begin(baud);
+                _port[instance]->set_flow_control(AP_HAL::UARTDriver::FLOW_CONTROL_DISABLE);
+            }
+        }
+        return NEW_NOTHROW AP_GPS_NOVA(*this, params[instance], state[instance], _port[instance]);
+#endif //AP_GPS_NOVA_ENABLED
     default:
         break;
     }
diff --git a/libraries/AP_GPS/AP_GPS_NOVA.cpp b/libraries/AP_GPS/AP_GPS_NOVA.cpp
index 95ffaaf2..27ea5394 100644
--- a/libraries/AP_GPS/AP_GPS_NOVA.cpp
+++ b/libraries/AP_GPS/AP_GPS_NOVA.cpp
@@ -76,6 +76,16 @@ AP_GPS_NOVA::read(void)
     if (gps._auto_config != AP_GPS::GPS_AUTO_CONFIG_DISABLE) {
         const uint32_t now = AP_HAL::millis();
 
+        // re-send the configuration if the receiver has gone quiet, e.g.
+        // because it booted after us or was power-cycled: until it is told
+        // which logs to output it sends nothing we can use
+        if (_init_blob_index >= ARRAY_SIZE(_initialisation_blob) &&
+            now - _last_good_msg_ms > NOVA_REINIT_TIMEOUT_MS &&
+            now - _last_reinit_ms > NOVA_REINIT_TIMEOUT_MS) {
+            _init_blob_index = 0;
+            _last_reinit_ms = now;
+        }
+
         if (_init_blob_index < (sizeof(_initialisation_blob) / sizeof(_initialisation_blob[0]))) {
             const char *init_str = _initialisation_blob[_init_blob_index];
 
@@ -98,6 +108,10 @@ AP_GPS_NOVA::read(void)
 #endif
         ret |= parse(temp);
     }
+
+    if (ret) {
+        _last_good_msg_ms = AP_HAL::millis();
+    }
     
     return ret;
 }
diff --git a/libraries/AP_GPS/AP_GPS_NOVA.h b/libraries/AP_GPS/AP_GPS_NOVA.h
index 4f60dff2..18a5c887 100644
--- a/libraries/AP_GPS/AP_GPS_NOVA.h
+++ b/libraries/AP_GPS/AP_GPS_NOVA.h
@@ -53,6 +53,9 @@ private:
     
     uint8_t _init_blob_index = 0;
     uint32_t _init_blob_time = 0;
+    uint32_t _last_good_msg_ms = 0;
+    uint32_t _last_reinit_ms = 0;
+    static constexpr uint32_t NOVA_REINIT_TIMEOUT_MS = 2000;
     static const char* const _initialisation_blob[4];
    
     uint32_t crc_error_counter = 0;
diff --git a/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/defaults.parm b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/defaults.parm
new file mode 100644
index 00000000..b30ab729
--- /dev/null
+++ b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/defaults.parm
@@ -0,0 +1,31 @@
+# AeroStem LightShow - default parameters for the AeroStem H743 V1
+# (embedded in the firmware; a full parameter reset returns to these)
+
+# --- battery monitor (internal voltage/current sensor) ---
+BATT_MONITOR 4
+
+# --- serial ports (same layout as the standard AeroStem firmware) ---
+# UART2 / DJI connector: DisplayPort
+SERIAL2_PROTOCOL 42
+# UART4: MAVLink2 (telemetry / show radio)
+SERIAL4_PROTOCOL 2
+# UART6: RC input
+SERIAL5_PROTOCOL 23
+# UART7: ESC telemetry
+SERIAL6_PROTOCOL 16
+OSD_TYPE2 5
+
+# --- RTK GNSS: Bynav M2 (NovAtel-compatible protocol) on the GPS port ---
+# NOVA protocol (NovAtel / Bynav / ComNav)
+GPS1_TYPE 15
+# must match the receiver's COM port baud rate
+SERIAL3_BAUD 115
+
+# --- show lights: WS2812 (NeoPixel) strip on output M10 ---
+# NeoPixel
+SHOW_LED0_TYPE 2
+# PWM output 10 (M10)
+SHOW_LED0_CHAN 10
+# number of LEDs on the strip - set to your strip
+SHOW_LED0_COUNT 16
+SHOW_LED0_GAMMA 2.2
diff --git a/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef-bl.dat b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef-bl.dat
new file mode 100755
index 00000000..1618d7c1
--- /dev/null
+++ b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef-bl.dat
@@ -0,0 +1,11 @@
+# AeroStem Technology - AeroStem H743 V1 bootloader definition
+# Pin map inherited (hardware identical); AeroStem board ID 7190.
+
+include ../MicoAir743/hwdef-bl.dat
+
+# Must match hwdef.dat
+undef APJ_BOARD_ID
+APJ_BOARD_ID AP_HW_AeroStemH743V1
+
+USB_STRING_MANUFACTURER "AeroStem"
+USB_STRING_PRODUCT "AeroStemH743V1-BL"
diff --git a/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef.dat b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef.dat
new file mode 100755
index 00000000..525f1a4f
--- /dev/null
+++ b/libraries/AP_HAL_ChibiOS/hwdef/AeroStemH743V1/hwdef.dat
@@ -0,0 +1,25 @@
+# AeroStem Technology - AeroStem H743 V1 flight controller
+# ArduPilot board definition (processed by chibios_hwdef.py)
+#
+# The AeroStem H743 V1 is pin-for-pin identical to the MicoAir743
+# (verified against the reference unit's on-board hwdef.dat, 2026-11-01).
+# We inherit the upstream pin map so every upstream fix/driver update
+# is picked up automatically, then apply AeroStem identity on top.
+
+include ../MicoAir743/hwdef.dat
+
+# ---------------------------------------------------------------------------
+# AeroStem identity
+# ---------------------------------------------------------------------------
+# AeroStem's own board ID (7190, block 7190-7199 requested for AeroStem
+# Technology - see docs/BOARD_ID_REQUEST.md). build_ardupilot.sh registers
+# AP_HW_AeroStemH743V1 in Tools/AP_Bootloader/board_types.txt if the
+# ArduPilot version being built doesn't have it yet.
+undef APJ_BOARD_ID
+APJ_BOARD_ID AP_HW_AeroStemH743V1
+
+USB_STRING_MANUFACTURER "AeroStem"
+USB_STRING_PRODUCT "AeroStemH743V1"
+
+# Everything else (10 PWM, BMI088+BMI270, DPS310, IST8310, AT7456E OSD,
+# SDMMC, CAN1, 8 serial ports) comes from the included pin map.
-- 
2.34.1

